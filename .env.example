# Django Core Settings
SECRET_KEY=your-secure-random-django-secret-key
DEBUG=False
ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://your-project.vercel.app,http://localhost:8000

# MySQL Production Database (e.g. PlanetScale, AWS RDS, Aiven, Railway, TiDB)
DB_NAME=orderless_db
DB_USER=orderless_user
DB_PASSWORD=your_secure_db_password
DB_HOST=your-mysql-host.example.com
DB_PORT=3306

# Redis Cache & Channels (Optional for production multi-worker real-time)
USE_REDIS=False
REDIS_URL=redis://127.0.0.1:6379/0

# Restaurant Identity
RESTAURANT_NAME=OrderLess Cafe
RESTAURANT_ADDRESS=123 Gourmet Street, Foodville
RESTAURANT_GSTIN=29ABCDE1234F1Z5

# Security Settings
SECURE_SSL_REDIRECT=False
